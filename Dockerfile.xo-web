# syntax=docker/dockerfile:1.7

ARG XO_VERSION=dev

FROM --platform=$BUILDPLATFORM docker.io/library/rust:1.89-bookworm AS wasm-builder
ARG XO_VERSION
ENV XO_VERSION=$XO_VERSION
WORKDIR /source
RUN apt-get update \
    && apt-get install --yes --no-install-recommends clang \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add wasm32-unknown-unknown \
    && cargo install wasm-pack --version 0.13.1 --locked
COPY Cargo.toml Cargo.lock rust-toolchain.toml LICENSE ./
COPY crates ./crates
RUN mkdir -p web/src/generated/xo-web \
    && cd crates/xo-web \
    && wasm-pack build . \
        --target web \
        --release \
        --out-dir ../../web/src/generated/xo-web

FROM --platform=$BUILDPLATFORM docker.io/library/node:22-alpine AS web-builder
ARG XO_VERSION
ENV XO_VERSION=$XO_VERSION
WORKDIR /source/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web ./
COPY --from=wasm-builder /source/web/src/generated/xo-web ./src/generated/xo-web
RUN npm run build

FROM docker.io/nginxinc/nginx-unprivileged:1.27-alpine AS xo-web
LABEL org.opencontainers.image.title="xo-web" \
      org.opencontainers.image.description="Static offline-first xo PWA"
COPY web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=web-builder /source/web/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
