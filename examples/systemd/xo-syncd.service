[Unit]
Description=xo synchronization server
Documentation=https://github.com/gnur/exokephalos
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=xo
Group=xo
StateDirectory=xo-syncd
StateDirectoryMode=0700
ExecStart=/usr/local/bin/xo-syncd --state-dir /var/lib/xo-syncd --bind 127.0.0.1:9464 --oidc-issuer https://id.example.com --oidc-audience https://notes.example.com --oidc-client-id YOUR_PUBLIC_CLIENT_ID
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=30s

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
