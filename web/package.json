{
  "name": "xo-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "build:wasm": "cd ../crates/xo-web && wasm-pack build . --target web --release --out-dir ../../web/src/generated/xo-web",
    "dev": "npm run build:wasm && vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test --project=chromium",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "lucide-react": "^1.28.0",
    "marked": "^17.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "1.2.0"
  }
}
