/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; font-src 'self'; worker-src 'self' blob:; connect-src 'self' https: wss:; manifest-src 'self'

/index.html
  Cache-Control: no-store

/version.json
  Cache-Control: no-store

/sw.js
  Cache-Control: no-store

/workbox-*.js
  Cache-Control: no-store

/manifest.webmanifest
  Cache-Control: no-store

/install.sh
  Cache-Control: no-store

/assets/*
  Cache-Control: public, max-age=31536000, immutable
